{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ESNext"],
    "outDir": "../dist-electron",
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "index.ts",
    "preload.ts",
    "database/**/*.ts",
    "ipc/**/*.ts",
    "services/**/*.ts"
  ]
}
