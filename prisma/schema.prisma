// Clinvo Platform — Prisma Schema for PostgreSQL
// Multi-Tenant Clinic Management with Strict GDPR Patient PII Protection

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── 1. Platform Super Admin (Password-Protected Platform Governance) ────────
model SuperAdmin {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String    @map("password_hash")
  salt           String
  name           String    @default("Super Admin")
  role           String    @default("SUPER_ADMIN")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("super_admins")
}

// ── 2. Clinics (Tenants) ────────────────────────────────────────────────────
model Clinic {
  id            String    @id @default(uuid())
  name          String
  ownerName     String    @map("owner_name")
  ownerEmail    String    @unique @map("owner_email")
  ownerPhone    String?   @map("owner_phone")
  speciality    String    @default("General Medicine")
  city          String    @default("Local")
  address       String?
  plan          String    @default("Starter Trial")
  status        String    @default("active") // "active", "trial", "expired", "suspended"
  currency      String    @default("INR")
  licenseKey    String    @unique @map("license_key")
  masterPinHash String?   @map("master_pin_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  doctors            Doctor[]
  services           ClinicService[]
  staff              StaffAccount[]
  receipts           Receipt[]
  platformAuditLogs  PlatformAuditLog[]
  gdprAuditLogs      GdprAccessAuditLog[]

  @@map("clinics")
}

// ── 3. Doctors ──────────────────────────────────────────────────────────────
model Doctor {
  id                 String    @id @default(uuid())
  clinicId           String    @map("clinic_id")
  clinic             Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name               String
  specialization     String
  qualifications     String?
  phone              String?
  address            String?
  registrationNumber String?   @map("registration_number")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  receipts           Receipt[]

  @@map("doctors")
}

// ── 4. Clinic Services & OPD Rates ──────────────────────────────────────────
model ClinicService {
  id        String   @id @default(uuid())
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  code      String?
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_services")
}

// ── 5. Staff Accounts & Roles ───────────────────────────────────────────────
model StaffAccount {
  id          String    @id @default(uuid())
  clinicId    String    @map("clinic_id")
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  username    String
  pinHash     String    @map("pin_hash")
  role        String    @default("receptionist") // "admin", "doctor", "receptionist"
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([clinicId, username])
  @@map("staff_accounts")
}

// ── 6. Receipts & Invoices with GDPR Patient PII Protection ─────────────────
// Complies with:
// - GDPR Article 5: Data minimization
// - GDPR Article 9: Special category health data protection
// - GDPR Article 17: Right to Erasure / Anonymization
// - GDPR Article 32: Security of processing & encryption at rest
model Receipt {
  id             String    @id @default(uuid())
  receiptNumber  String    @map("receipt_number") // Sequential financial invoice number
  clinicId       String    @map("clinic_id")
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId       String?   @map("doctor_id")
  doctor         Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorName     String    @map("doctor_name")
  date           DateTime  @default(now())
  totalAmount    Float     @map("total_amount")
  paymentMethod  String    @default("CASH") @map("payment_method") // "CASH", "ONLINE", "CARD", "FREE", "INSURANCE"
  lineItemsJson  Json      @map("line_items_json") // Breakdown of consultation & lab services

  // ── GDPR Field-Level Encrypted Patient PII (AES-256-GCM) ───────────────────
  // NEVER stored as plaintext in PostgreSQL. Ciphertext format: "enc:<iv_hex>:<tag_hex>:<cipher_hex>"
  patientNameEncrypted    String  @map("patient_name_encrypted")
  patientPhoneEncrypted   String? @map("patient_phone_encrypted")
  patientDobEncrypted     String? @map("patient_dob_encrypted")
  patientAddressEncrypted String? @map("patient_address_encrypted")
  diagnosisEncrypted      String? @map("diagnosis_encrypted") // Health details (GDPR Art. 9)

  // Non-identifying demographic categories for clinical operations
  patientAge    String? @map("patient_age")
  patientGender String? @map("patient_gender")

  // ── Pseudonymization & Blind Indexing (GDPR Art. 4(5) & 32) ─────────────────
  pseudonymId     String  @unique @map("pseudonym_id") // Cryptographic public reference (e.g. "PAT-9X2A-44B1")
  phoneSearchHash String? @map("phone_search_hash") // Blind HMAC-SHA256 index for lookup without plaintext
  nameSearchHash  String? @map("name_search_hash")

  // ── GDPR Lawful Basis & Consent Tracking (GDPR Art. 6 & 9) ──────────────────
  consentGiven        Boolean   @default(true) @map("consent_given")
  consentTimestamp    DateTime  @default(now()) @map("consent_timestamp")
  legalBasis          String    @default("HEALTHCARE_PROVISION_ART_9_2_H") @map("legal_basis")
  retentionExpiryDate DateTime? @map("retention_expiry_date")

  // ── GDPR Right to Erasure / Anonymization (GDPR Art. 17) ────────────────────
  // Financial numbers & amounts remain for tax audit compliance, but patient PII is scrubbed.
  isAnonymized        Boolean   @default(false) @map("is_anonymized")
  anonymizedAt        DateTime? @map("anonymized_at")
  anonymizedBy        String?   @map("anonymized_by")
  anonymizationReason String?   @map("anonymization_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accessLogs GdprAccessAuditLog[]

  @@index([clinicId, date])
  @@index([phoneSearchHash])
  @@map("receipts")
}

// ── 7. GDPR Access Audit Log (GDPR Article 30 & 33 Records of Processing) ───
model GdprAccessAuditLog {
  id               String   @id @default(uuid())
  clinicId         String   @map("clinic_id")
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  receiptId        String?  @map("receipt_id")
  receipt          Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  patientPseudonym String?  @map("patient_pseudonym")
  performedBy      String   @map("performed_by")
  staffRole        String   @map("staff_role") // "admin", "doctor", "receptionist", "SUPER_ADMIN"
  action           String   // "VIEW_PII", "DECRYPT_PII", "EXPORT_PII", "ANONYMIZE_PII", "UPDATE_PII"
  purpose          String   @default("CLINICAL_BILLING") // "CLINICAL_BILLING", "CONSULTATION", "DSAR_EXPORT", "RIGHT_TO_ERASURE"
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  timestamp        DateTime @default(now())

  @@index([clinicId, timestamp])
  @@index([receiptId])
  @@map("gdpr_access_audit_logs")
}

// ── 8. Platform System Audit Log ────────────────────────────────────────────
model PlatformAuditLog {
  id         String   @id @default(uuid())
  clinicId   String?  @map("clinic_id")
  clinic     Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  userName   String   @map("user_name")
  userRole   String   @map("user_role")
  clinicName String?  @map("clinic_name")
  action     String
  details    String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@map("platform_audit_logs")
}
